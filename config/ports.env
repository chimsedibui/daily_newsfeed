# Cong cua toan bo stack - mot cho duy nhat de doi.
#
# Vi sao khong dung cong mac dinh: job nay chay thuong tru, giu trang thai san
# sang trigger. Postgres 5432 va Airflow 8080 la hai cong bi gianh nhieu nhat
# tren may dev, va khi dung nhau thi trieu chung la "connection refused" hoac
# te hon la ket noi nham vao service khac.
#
# Cac cong duoi day nam trong dai 18000-18999, it va cham.
#
# Doc boi: scripts/pg.sh, scripts/airflow.sh, scripts/status.sh
# Doi cong -> chay lai `./scripts/ports.sh check` de kiem tra truoc khi khoi dong.

# Postgres (du lieu nghiep vu + metadata cua Airflow)
NEWS_PG_PORT=18432

# Airflow webserver
NEWS_AIRFLOW_PORT=18080

# Trang trang thai (scripts/status.sh)
NEWS_STATUS_PORT=18081

# Chi nghe tren loopback. Day la stack dev, khong mo ra mang.
NEWS_BIND_HOST=127.0.0.1

# ===== Quan sat tai nguyen may (scripts/obs.sh) =====
# Tach hoan toan khoi trang trang thai o 18081: trang do lo nghiep vu
# (run, chi phi, nguon tin), Grafana lo CPU/RAM/dia/mang. Khong panel nao lap lai.

# Prometheus (TSDB + scrape)
NEWS_PROM_PORT=18090

# Grafana
NEWS_GRAFANA_PORT=18091

# node_exporter - so lieu may
NEWS_NODE_EXPORTER_PORT=18092

# postgres_exporter - so lieu tien trinh Postgres
NEWS_PG_EXPORTER_PORT=18093
