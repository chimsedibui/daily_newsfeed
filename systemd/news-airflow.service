[Unit]
Description=news-bot Airflow (scheduler + webserver)
After=news-postgres.service
Requires=news-postgres.service

[Service]
Type=simple
WorkingDirectory=__REPO__
# `airflow standalone` chay ca scheduler lan webserver trong mot tien trinh cha.
ExecStart=/usr/bin/env bash "__REPO__/scripts/airflow.sh" standalone
Restart=always
RestartSec=15
# Airflow can vai chuc giay de migrate va nap DAG lan dau.
TimeoutStartSec=300
KillMode=mixed
KillSignal=SIGINT

[Install]
WantedBy=default.target
