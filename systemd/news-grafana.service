[Unit]
Description=news-bot Grafana (dashboard tai nguyen may)
After=news-prometheus.service
Wants=news-prometheus.service

[Service]
Type=exec
WorkingDirectory=__REPO__
ExecStart=/usr/bin/env bash "__REPO__/scripts/obs.sh" serve-grafana
Restart=always
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=default.target
