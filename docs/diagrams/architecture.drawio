<mxfile host="app.diagrams.net" type="device"><diagram name="Kiến trúc tổng thể" id="architecture"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="515" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="box_af" value="&lt;b&gt;Airflow  ·  DAG daily_news_digest&lt;/b&gt;&lt;br/&gt;&lt;font style="font-size:10px;color:#5b6472"&gt;lịch 08:00 giờ VN, T2–T6  ·  mỗi task chạm app chạy bằng @task.external_python&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fbfcfe;strokeColor=#c6cedb;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#5b6472;html=1;" vertex="1" parent="1"><mxGeometry x="275" y="45" width="680" height="292" as="geometry"/></mxCell><mxCell id="src" value="&lt;b&gt;42 nguồn tin&lt;/b&gt;&lt;br/&gt;&lt;font style="font-size:10px;color:#5b6472"&gt;40 RSS  ·  1 HF Papers&lt;/font&gt;&lt;br/&gt;&lt;font style="font-size:10px;color:#5b6472"&gt;1 GitHub Trending&lt;/font&gt;&lt;br/&gt;&lt;font style="font-size:10px;color:#5b6472"&gt;31 publisher, 15 chuyên mục&lt;/font&gt;" style="rounded=1;arcSize=14;fillColor=#f4f5f7;strokeColor=#b9bfc9;html=1;fontSize=12;fontColor=#1f2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="45" y="190" width="200" height="110" as="geometry"/></mxCell><mxCell id="preflight" value="&lt;b&gt;preflight&lt;/b&gt;&lt;br/&gt;&lt;font style="font-size:10px;color:#5b6472"&gt;đọc sources.yaml&lt;/font&gt;" style="rounded=1;arcSize=14;fillColor=#e7f0fd;strokeColor=#7ba3e0;html=1;fontSize=12;fontColor=#1f2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="295" y="100" width="125" height="48" as="geometry"/></mxCell><mxCell id="create_run" value="&lt;b&gt;create_run&lt;/b&gt;&lt;br/&gt;&lt;font style="font-size:10px;color:#5b6472"&gt;mở pipeline_run&lt;/font&gt;" style="rounded=1;arcSize=14;fillColor=#e7f0fd;strokeColor=#7ba3e0;html=1;fontSize=12