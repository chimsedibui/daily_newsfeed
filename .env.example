# ---- Google Chat ----
# Space > Apps & integrations > Webhooks > Copy URL (giữ nguyên cả key & token)
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=...&token=...
# false = mỗi bản tin là một message riêng ở cuối space (mặc định khi chạy thật).
# true  = gom ba bản tin trong ngày vào một thread — chỉ tiện khi thử nghiệm.
GOOGLE_CHAT_THREAD_PER_DAY=false

# ---- LLM ----
# openai | vertex | gemini
#   vertex = Vertex AI qua ADC (gcloud auth application-default login).
#            Tiện lúc thử, nhưng ADC của tài khoản người dùng SẼ hết hạn.
#   gemini = Gemini Developer API bằng API key. Không hết hạn, và tiền đi vào
#            tài khoản gắn với key chứ không vào project GCP.
LLM_PROVIDER=gemini

GEMINI_API_KEY=AQ....
OPENAI_API_KEY=sk-proj-...
VERTEX_PROJECT=
VERTEX_LOCATION=global
# 0 = tắt suy luận. Họ Flash bật mặc định và tiêu ~750 token nghĩ mỗi bài,
# làm chi phí gấp 2,3 lần. Tham số này KHÔNG được gửi cho model *-lite —
# chúng không suy luận, và 3.5-flash-lite trả 400 khi nhận nó.
VERTEX_THINKING_BUDGET=0
# 36 lần gọi/ngày -> bản lite rẻ nhất còn mở cho người dùng mới.
SUMMARIZER_MODEL=gemini-3.1-flash-lite
# Biên tập: 2 lần gọi/ngày -> dùng bản tốt hơn, chênh lệch vài phần nghìn đô.
EDITOR_MODEL=gemini-3.8-flash

# Giữ dữ liệu bao nhiêu ngày (xem docs/OPERATIONS.md)
RETENTION_DAYS=14

# ---- Postgres (trace + logging + article store) ----
POSTGRES_DSN=postgresql+psycopg://news:news@localhost:5432/news

# ---- Pipeline ----
NEWS_TIMEZONE=Asia/Ho_Chi_Minh
LOOKBACK_HOURS=24
MAX_ARTICLES_PER_SOURCE=40
DIGEST_SIZE=12
LOG_LEVEL=INFO
LOG_JSON=true
# Chạy thử: không gọi LLM thật, không bắn webhook
DRY_RUN=false
