# ---- Google Chat ----
# Space > Apps & integrations > Webhooks > Copy URL (giữ nguyên cả key & token)
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=...&token=...
# Gửi các bản tin trong cùng 1 thread theo ngày (Google Chat threadKey)
GOOGLE_CHAT_THREAD_PER_DAY=true

# ---- LLM (OpenAI) ----
OPENAI_API_KEY=sk-proj-...
# Model tóm tắt từng bài (~24 lần gọi/ngày). Cần gạt chi phí rõ nhất:
# đổi sang gpt-5.6-luna ($0.20/$1.20 per MTok thay vì $2/$12).
SUMMARIZER_MODEL=gpt-5.6-terra
# Model biên tập bản tin tổng (1 lần gọi/ngày, cần chất lượng nhất)
EDITOR_MODEL=gpt-6-astra

# ---- Postgres (trace + logging + article store) ----
POSTGRES_DSN=postgresql+psycopg://news:news@localhost:5432/news

# ---- Pipeline ----
NEWS_TIMEZONE=Asia/Ho_Chi_Minh
LOOKBACK_HOURS=24
MAX_ARTICLES_PER_SOURCE=40
DIGEST_SIZE=12
LOG_LEVEL=INFO
LOG_JSON=true
# Chạy thử: không gọi LLM thật, không bắn webhook
DRY_RUN=false
